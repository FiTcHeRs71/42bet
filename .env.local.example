# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est jamais commité.

# ---- NextAuth ----
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- API 42 (OAuth2) ----
# Créer l'app sur https://profile.intra.42.fr/oauth/applications
# Redirect URI : http://localhost:3000/api/auth/callback/42
FT_API_UID=
FT_API_SECRET=
FT_API_CAMPUS_ID=33   # 33 = Lausanne

# ---- football-data.org ----
# Clé gratuite : https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# ---- Supabase ----
# Récupérer dans Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# /!\ service_role : JAMAIS exposé côté client
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cron Vercel ----
# Générer avec : openssl rand -base64 32
CRON_SECRET=
