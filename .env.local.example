# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est jamais commité.

# ---- NextAuth (Auth.js v5) ----
# Générer avec : openssl rand -base64 32
AUTH_SECRET=
# URL de base (optionnelle en dev, inférée). À fixer en prod.
AUTH_URL=http://localhost:3000

# ---- API 42 (OAuth2) ----
# Créer l'app sur https://profile.intra.42.fr/oauth/applications
# Redirect URI : http://localhost:3000/api/auth/callback/42
FT_API_UID=
FT_API_SECRET=
FT_API_CAMPUS_ID=33   # 33 = Lausanne

# ---- football-data.org ----
# Clé gratuite : https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# ---- Supabase ----
# Récupérer dans Project Settings > API keys.
# NB : Supabase a renommé ses clés. Les noms de variables ci-dessous restent
# historiques, mais les valeurs attendues sont les NOUVELLES clés :
#   - clé "publishable" (sb_publishable_...) -> remplace l'ancienne "anon"     (publique, OK navigateur)
#   - clé "secret"      (sb_secret_...)      -> remplace l'ancienne "service_role" (server-only, bypass RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# /!\ clé secret (service_role) : JAMAIS exposée côté client
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cron Vercel ----
# Générer avec : openssl rand -base64 32
CRON_SECRET=
